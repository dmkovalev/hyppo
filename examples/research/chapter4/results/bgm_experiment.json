{
 "domain": "astro (BGM)",
 "hypotheses": {
  "density_law": {
   "label": "Закон плотности",
   "task": 1,
   "equations": [
    "g_rho = exp(-sqrt(1/4 + (R**2 + z**2/eps**2)/h_p**2)) - exp(-sqrt(1/4 + (R**2 + z**2/eps**2)/h_m**2))"
   ],
   "in": [
    "R",
    "eps",
    "h_m",
    "h_p",
    "z"
   ],
   "out": [
    "g_rho"
   ],
   "variants": 1,
   "note": "Einasto law of the thin disc; g_rho(R, z; eps) is the profile shape for axis ratio eps, h_p/h_m the outer/inner scale lengths"
  },
  "age_cells": {
   "label": "Возрастные ячейки",
   "task": 1,
   "equations": [
    "x_c = (t_lo + t_hi)/2",
    "d = t_hi - t_lo"
   ],
   "in": [
    "t_hi",
    "t_lo"
   ],
   "out": [
    "d",
    "x_c"
   ],
   "variants": 3,
   "note": "7 thin-disc age bins; 3 variants of the thin-disc formation age (upper edge of the oldest bin)"
  },
  "SFR": {
   "label": "Закон SFR",
   "task": 1,
   "equations": [
    "psi = exp(gam*tau)"
   ],
   "in": [
    "gam",
    "tau"
   ],
   "out": [
    "psi"
   ],
   "variants": 2,
   "note": "star formation law psi(tau) = exp(gamma*tau) on the age grid tau; gamma in {0.12, 0.25} (eq:sfr)"
  },
  "IMF": {
   "label": "IMF",
   "task": 1,
   "equations": [
    "xi = A_xi*m**(-alpha)",
    "A_xi = (2 - alpha)/(m_up**(2 - alpha) - m_lo**(2 - alpha))"
   ],
   "in": [
    "alpha",
    "m",
    "m_lo",
    "m_up"
   ],
   "out": [
    "A_xi",
    "xi"
   ],
   "variants": 11,
   "note": "power-law IMF xi(m) = A m^-alpha, mass-normalised on [m_lo, m_up] (integral of m*xi dm = 1); 11 variants of alpha"
  },
  "local_volume_density": {
   "label": "Локальная объёмная плотность",
   "task": 2,
   "equations": [
    "eps_i = Eval(eps_t, x_c)",
    "rho = rho_sun*Eval(g_rho, eps_i)"
   ],
   "in": [
    "eps_t",
    "g_rho",
    "rho_sun",
    "x_c"
   ],
   "out": [
    "eps_i",
    "rho"
   ],
   "variants": 3,
   "note": "axis ratio of every bin from the age-axis-ratio relation eps_t at the bin centre; local density rho_i = rho_sun_i * g_rho(eps_i); 3 sets of local mass densities"
  },
  "star_birthrate": {
   "label": "Функция звёздной рождаемости",
   "task": 2,
   "equations": [
    "SFR_i = Eval(psi, x_c)*d",
    "b = SFR_i*xi"
   ],
   "in": [
    "d",
    "psi",
    "x_c",
    "xi"
   ],
   "out": [
    "SFR_i",
    "b"
   ],
   "variants": 1,
   "note": "SFR(i) = exp(gamma x_c(i)) d (eq:sfr) and the birthrate b(m, i) = SFR(i) IMF(m) (eq:birthrate)"
  },
  "evolutionary_tracks": {
   "label": "Эволюционные треки",
   "task": 3,
   "equations": [
    "w_i = Eval(W_trk, x_c)",
    "L_iso = Eval(L_trk, m, x_c)",
    "rho_dyn = rho/(1 - w_i)"
   ],
   "in": [
    "L_trk",
    "W_trk",
    "m",
    "rho",
    "x_c"
   ],
   "out": [
    "L_iso",
    "rho_dyn",
    "w_i"
   ],
   "variants": 2,
   "note": "track set evaluated at the bin ages: isochrones L_iso(m, i) and the remnant mass fraction w_i; dynamical (stars + remnants) density rho_dyn = rho/(1 - w_i); 2 track sets"
  },
  "local_luminosity": {
   "label": "Локальная светимость",
   "task": 4,
   "equations": [
    "ell = Conv(b, L_iso, BC_atm)",
    "j_L = rho*ell"
   ],
   "in": [
    "BC_atm",
    "L_iso",
    "b",
    "rho"
   ],
   "out": [
    "ell",
    "j_L"
   ],
   "variants": 3,
   "note": "luminosity per unit mass formed, birthrate convolved with the isochrones and the bolometric corrections of the atmosphere models; local luminosity density j_L = rho * ell; 3 atmosphere sets"
  },
  "velocity_dispersion": {
   "label": "Дисперсия скоростей",
   "task": 4,
   "equations": [
    "Phi = Poisson(rho_dyn)",
    "sigma_W = Jeans(rho_dyn, Phi)"
   ],
   "in": [
    "rho_dyn"
   ],
   "out": [
    "Phi",
    "sigma_W"
   ],
   "variants": 1,
   "note": "vertical potential from the dynamical density (Poisson) and the vertical velocity dispersion of every isothermal population from the vertical Jeans equation"
  },
  "dynamical_self_consistency": {
   "label": "Динамическая самосогласованность",
   "task": 5,
   "equations": [
    "Upsilon = Tot(rho_dyn)/Tot(j_L)",
    "chi_dyn = Chi2(sigma_W, sigma_obs) + Chi2(Upsilon, Upsilon_obs)"
   ],
   "in": [
    "Upsilon_obs",
    "j_L",
    "rho_dyn",
    "sigma_W",
    "sigma_obs"
   ],
   "out": [
    "Upsilon",
    "chi_dyn"
   ],
   "variants": 1,
   "note": "local dynamical mass-to-light ratio and the misfit of the predicted dispersions and M/L against observations (Bienayme et al. 1987)"
  }
 },
